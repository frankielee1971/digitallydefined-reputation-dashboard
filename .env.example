# DigitallyDefined Dashboard - Environment Variables
# Copy to .env.local and fill in your values. NEVER commit .env.local

# Supabase project URL (no trailing slash)
VITE_SUPABASE_URL=https://dijjlppdljpcgyoakdnq.supabase.co

# Supabase anonymous key (safe for frontend)
VITE_SUPABASE_ANON_KEY=

# Shared API key sent as x-api-key to the Hermes edge function.
# MUST match DASHBOARD_API_KEY in the os-backend secrets.
VITE_DASHBOARD_API_KEY=

# Assistant model override passed to the Hermes edge function.
# "auto" lets OmniRoute pick the best available model.
VITE_DASHBOARD_ASSISTANT_MODEL=auto

# --- Optional integrations (feature-flagged) ---
# VITE_GA_INTEGRATION_ENABLED=false
# VITE_GA_MEASUREMENT_ID=
# VITE_GA_PROPERTY_ID=
# VITE_SOCIAL_INTEGRATION_ENABLED=false
# VITE_FACEBOOK_PAGE_ID=
# VITE_INSTAGRAM_BUSINESS_ID=
# VITE_YOUTUBE_CHANNEL_ID=
# VITE_LINKEDIN_ORG_ID=
# VITE_EMAIL_INTEGRATION_ENABLED=false
# VITE_EMAIL_PROVIDER=brevo
# VITE_COMMUNITY_INTEGRATION_ENABLED=false
# VITE_COMMUNITY_PLATFORM=facebook